  "descriptions": {
    "zh-CN": "文字识别(OCR)模块",
    "en-US": "Optical Character Recognition module",
    "zh-TW": "文字辨識模組",
    "ja": "OCRモジュール",
    "ko": "OCR 모듈",
    "es": "Módulo OCR",
    "fr": "Module OCR",
    "de": "OCR-Modul",
    "pt-BR": "Módulo OCR",
    "ru": "Модуль OCR",
    "ar": "وحدة التعرف على النصوص",
    "hi": "OCR मॉड्यूल"
  },
  "overviews": {
    "zh-CN": "提供本地OCR文字识别能力，支持图片文字提取、区域识别、多语言识别、表格识别等功能。调用系统原生OCR引擎（macOS Vision/Windows OCR/Linux Tesseract）。",
    "en-US": "Local OCR text recognition using native engines (macOS Vision/Windows OCR/Linux Tesseract). Supports image text extraction, region recognition, multi-language, and table recognition.",
    "zh-TW": "提供本地OCR文字識別能力，支援图片文字提取、區域識別、多語言識別、表格識別等功能。呼叫系統原生OCR引擎（macOS Vision/Windows OCR/Linux Tesseract）。",
    "ja": "ネイティブエンジン(macOS Vision/Windows OCR/Linux Tesseract)によるローカルOCR。画像テキスト抽出・領域認識・多言語・表認識。",
    "ko": "네이티브 엔진(macOS Vision/Windows OCR/Linux Tesseract)을 사용한 로컬 OCR. 이미지 텍스트 추출, 영역, 다국어, 표 인식.",
    "es": "OCR local con motores nativos (macOS Vision/Windows OCR/Linux Tesseract). Extracción de texto, región, multiidioma y tablas.",
    "fr": "OCR local avec moteurs natifs (macOS Vision/Windows OCR/Linux Tesseract). Extraction de texte, région, multilingue et tableaux.",
    "de": "Lokale OCR mit nativen Engines (macOS Vision/Windows OCR/Linux Tesseract). Textextraktion, Region, Mehrsprachig und Tabellen.",
    "pt-BR": "OCR local com engines nativos (macOS Vision/Windows OCR/Linux Tesseract). Extração de texto, região, multilíngue e tabelas.",
    "ru": "Локальное OCR с нативными движками (macOS Vision/Windows OCR/Linux Tesseract). Извлечение текста, области, многоязычность и таблицы.",
    "ar": "OCR محلي بمحركات أصلية (macOS Vision/Windows OCR/Linux Tesseract). استخراج نص ومنطقة ومتعدد اللغات وجداول.",
    "hi": "नेटिव इंजन (macOS Vision/Windows OCR/Linux Tesseract) से लोकल OCR। टेक्स्ट, रीजन, मल्टी-लैंग्वेज और टेबल।"
  },
