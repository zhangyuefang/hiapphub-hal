  "overviews": {
    "zh-CN": "提供邮件收发能力，支持SMTP发送、IMAP/POP3收取、附件处理、HTML邮件、多收件人等功能。",
    "en-US": "Email send/receive support including SMTP sending, IMAP/POP3 fetching, attachment handling, HTML emails, and multiple recipients."
  },
  "permission": "network",
  "functions": [
    {
      "name": "send",
      "symbol": "hap_email_send",
      "descriptions": {
        "zh-CN": "发送邮件",
        "en-US": "Send email"
      },
      "params": [
        {
          "name": "smtp_host",
          "type": "string",
          "descs": {
            "zh-CN": "SMTP服务器",
            "en-US": "SMTP server"
          }
        },
        {
          "name": "smtp_port",
          "type": "number",
          "optional": true,
          "default_value": "587",
          "descs": {
            "zh-CN": "端口",
            "en-US": "Port"
          }
        },
        {
          "name": "username",
          "type": "string",
          "descs": {
            "zh-CN": "用户名",
            "en-US": "Username"
          }
        },
        {
          "name": "password",
          "type": "string",
          "descs": {
            "zh-CN": "密码/授权码",
            "en-US": "Password/auth code"
          }
        },
        {
          "name": "from",
          "type": "string",
          "descs": {
            "zh-CN": "发件人",
            "en-US": "From"
          }
        },
        {
          "name": "to",
          "type": "array",
          "descs": {
            "zh-CN": "收件人列表",
            "en-US": "Recipients"
          }
        },
        {
          "name": "subject",
          "type": "string",
          "descs": {
            "zh-CN": "主题",
            "en-US": "Subject"
          }
        },
        {
          "name": "body",
          "type": "string",
          "descs": {
            "zh-CN": "正文",
            "en-US": "Body"
          }
        },
        {
