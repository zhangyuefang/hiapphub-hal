        },
        {
          "name": "bcc",
          "type": "array",
          "optional": true,
          "descs": {
            "zh-CN": "密送",
            "en-US": "BCC"
          }
        },
        {
          "name": "attachments",
          "type": "array",
          "optional": true,
          "descs": {
            "zh-CN": "附件路径列表",
            "en-US": "Attachment paths"
          }
        },
        {
          "name": "use_tls",
          "type": "boolean",
          "optional": true,
          "default_value": "true",
          "descs": {
            "zh-CN": "使用TLS",
            "en-US": "Use TLS"
          }
        }
