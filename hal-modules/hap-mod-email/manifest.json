          "type": "boolean",
          "optional": true,
          "default_value": "false",
          "descs": {
            "zh-CN": "是否HTML格式",
            "en-US": "HTML format"
          }
        },
        {
          "name": "cc",
          "type": "array",
          "optional": true,
          "descs": {
            "zh-CN": "抄送",
            "en-US": "CC"
