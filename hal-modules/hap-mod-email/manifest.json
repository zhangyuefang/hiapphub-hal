  "overviews": {
    "zh-CN": "提供邮件收发能力，支持SMTP发送、IMAP/POP3收取、附件处理、HTML邮件、多收件人等功能。",
    "en-US": "Email send/receive support including SMTP sending, IMAP/POP3 fetching, attachment handling, HTML emails, and multiple recipients."
  },
  "permission": "network",
  "functions": [
    {
      "name": "send",
      "symbol": "hap_email_send",
      "descriptions": {
        "zh-CN": "通过 SMTP 协议发送电子邮件，支持HTML正文、抄送和附件",
        "en-US": "Send email via SMTP with HTML body, CC/BCC and attachments support"
      },
      "params": [
        {
          "name": "smtp_host",
          "type": "string",
          "descs": {
            "zh-CN": "SMTP服务器",
            "en-US": "SMTP server"
          }
        },
        {
          "name": "smtp_port",
          "type": "number",
          "optional": true,
          "default_value": "587",
          "descs": {
            "zh-CN": "smtp_port参数",
            "en-US": "smtp_port parameter"
          },
          "desc": "smtp_port parameter"
        },
        {
          "name": "username",
          "type": "string",
          "descs": {
            "zh-CN": "SMTP登录用户名",
            "en-US": "SMTP login username"
          },
          "desc": "SMTP login username"
        },
        {
          "name": "password",
          "type": "string",
          "descs": {
            "zh-CN": "密码/授权码",
            "en-US": "Password/auth code"
          }
        },
        {
          "name": "from",
          "type": "string",
          "descs": {
            "zh-CN": "发件人邮箱地址",
            "en-US": "Sender email address"
          },
          "desc": "Sender email address"
        },
        {
          "name": "to",
          "type": "array",
          "descs": {
            "zh-CN": "收件人列表",
            "en-US": "Recipients"
          }
        },
        {
          "name": "subject",
          "type": "string",
          "descs": {
            "zh-CN": "邮件主题",
            "en-US": "Email subject"
          },
          "desc": "Email subject"
        },
        {
          "name": "body",
          "type": "string",
          "descs": {
            "zh-CN": "请求体内容",
            "en-US": "Request body content"
          },
          "desc": "Request body content"
        },
        {
          "name": "html",
          "type": "boolean",
          "optional": true,
          "default_value": "false",
          "descs": {
            "zh-CN": "是否HTML格式",
            "en-US": "HTML format"
          }
        },
        {
          "name": "cc",
          "type": "array",
          "optional": true,
          "descs": {
            "zh-CN": "抄送邮箱地址列表",
            "en-US": "CC email address list"
          },
          "desc": "CC email address list"
        },
        {
          "name": "bcc",
          "type": "array",
          "optional": true,
          "descs": {
            "zh-CN": "密送邮箱地址列表",
            "en-US": "BCC email address list"
          },
          "desc": "BCC email address list"
        },
        {
          "name": "attachments",
          "type": "array",
          "optional": true,
          "descs": {
            "zh-CN": "附件路径列表",
            "en-US": "Attachment paths"
          }
        },
        {
          "name": "use_tls",
          "type": "boolean",
          "optional": true,
          "default_value": "true",
          "descs": {
            "zh-CN": "使用TLS",
            "en-US": "Use TLS"
          }
        }
      ],
      "returns": {
        "type": "SendResult",
        "descs": {
          "zh-CN": "发送结果",
          "en-US": "Send result"
        }
      },
      "bridge_path": "email.send",
      "group": "send",
      "async": true,
      "description": "Send email via SMTP with HTML body, CC/BCC and attachments support"
    },
    {
      "name": "fetch",
      "symbol": "hap_email_fetch",
      "descriptions": {
        "zh-CN": "通过 IMAP 协议获取邮箱中的邮件列表（支持只获取未读）",
        "en-US": "Fetch email list via IMAP (supports unseen only filter)"
      },
      "params": [
        {
          "name": "protocol",
          "type": "string",
          "descs": {
            "zh-CN": "协议: imap/pop3",
            "en-US": "Protocol: imap/pop3"
          }
        },
        {
          "name": "host",
          "type": "string",
          "descs": {
            "zh-CN": "主机地址（IP或域名）",
            "en-US": "Host (IP or domain)"
          },
          "desc": "Host (IP or domain)"
        },
        {
          "name": "port",
          "type": "number",
          "optional": true,
          "descs": {
            "zh-CN": "IMAP服务器端口号",
            "en-US": "IMAP server port number"
          },
          "desc": "IMAP server port number"
        },
        {
          "name": "username",
          "type": "string",
          "descs": {
            "zh-CN": "IMAP登录用户名",
            "en-US": "IMAP login username"
          },
          "desc": "IMAP login username"
        },
        {
          "name": "password",
          "type": "string",
          "descs": {
            "zh-CN": "密码字符串",
            "en-US": "Password string"
          },
          "desc": "Password string"
        },
        {
          "name": "folder",
          "type": "string",
          "optional": true,
          "default_value": "\"INBOX\"",
          "descs": {
            "zh-CN": "邮箱文件夹名（如INBOX/Sent）",
            "en-US": "Mailbox folder name (e.g. INBOX/Sent)"
          },
          "desc": "Mailbox folder name (e.g. INBOX/Sent)"
        },
        {
          "name": "limit",
          "type": "number",
          "optional": true,
          "default_value": "20",
          "descs": {
            "zh-CN": "获取数量",
            "en-US": "Fetch limit"
          }
        },
        {
          "name": "unseen_only",
          "type": "boolean",
          "optional": true,
          "default_value": "false",
          "descs": {
            "zh-CN": "unseen_only参数",
            "en-US": "unseen_only parameter"
          },
          "desc": "unseen_only parameter"
        },
        {
          "name": "use_tls",
          "type": "boolean",
          "optional": true,
          "default_value": "true",
          "descs": {
            "zh-CN": "使用TLS",
            "en-US": "Use TLS"
          }
        }
      ],
      "returns": {
        "type": "array",
        "descs": {
          "zh-CN": "邮件列表",
          "en-US": "Email list"
        }
      },
      "bridge_path": "email.fetch",
      "group": "receive",
      "async": true,
      "description": "Fetch email list via IMAP (supports unseen only filter)"
    },
