  "overviews": {
    "zh-CN": "提供 ZIP/TAR/GZ/BZ2/XZ 等常见归档格式的创建、解压、列表及流式处理能力。支持密码保护 ZIP、多文件批量操作、归档信息查询等功能。",
    "en-US": "Create, extract, list, and stream common archive formats (ZIP/TAR/GZ/BZ2/XZ). Supports password-protected ZIP, batch operations, and archive metadata queries."
  }
