        }
      ],
      "returns": {
        "type": "BleConnection",
        "descs": {
          "zh-CN": "连接信息",
          "en-US": "Connection info"
        }
      },
      "bridge_path": "bluetooth.connect",
      "group": "connection",
      "async": true,
      "description": "Connect to specified BLE device"
    },
