      "params": [
        {
          "name": "device_id",
          "type": "string",
          "descs": {
            "zh-CN": "设备ID",
            "en-US": "Device ID"
          }
        }
      ],
      "returns": {
        "type": "boolean",
        "descs": {
          "zh-CN": "是否成功",
          "en-US": "Success"
        }
      },
      "bridge_path": "bluetooth.disconnect",
      "group": "connection",
      "description": "Disconnect from specified BLE device"
