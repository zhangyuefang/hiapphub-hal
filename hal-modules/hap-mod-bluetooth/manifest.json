  "category": "hardware",
  "descriptions": {
    "zh-CN": "蓝牙BLE通信模块",
    "en-US": "Bluetooth BLE communication module"
  },
  "overviews": {
    "zh-CN": "提供蓝牙低功耗(BLE)通信能力，支持设备扫描、连接、服务发现、特征值读写、通知订阅等功能。",
    "en-US": "Provides Bluetooth Low Energy (BLE) communication including device scanning, connection, service discovery, characteristic read/write, and notification subscription."
  },
  "permission": "bluetooth",
  "functions": [
    {
      "name": "scan_start",
      "symbol": "hap_bluetooth_scan_start",
      "descriptions": {
        "zh-CN": "启动蓝牙低功耗（BLE）设备扫描，可按名称过滤",
        "en-US": "Start BLE device scanning with optional name filter"
      },
      "params": [
        {
          "name": "duration_ms",
          "type": "number",
          "optional": true,
          "default_value": "10000",
          "descs": {
            "zh-CN": "扫描时长(毫秒)",
            "en-US": "Scan duration (ms)"
          }
        },
        {
          "name": "filter_name",
          "type": "string",
          "optional": true,
          "descs": {
            "zh-CN": "按名称过滤",
            "en-US": "Filter by name"
          }
        }
      ],
      "returns": {
        "type": "array",
        "descs": {
          "zh-CN": "设备列表",
          "en-US": "Device list"
        }
      },
      "bridge_path": "bluetooth.scanStart",
      "group": "scan",
      "async": true,
      "description": "Start BLE device scanning with optional name filter"
    },
    {
      "name": "scan_stop",
      "symbol": "hap_bluetooth_scan_stop",
      "descriptions": {
        "zh-CN": "停止正在进行的蓝牙设备扫描",
        "en-US": "Stop ongoing Bluetooth device scanning"
      },
      "params": [],
      "returns": {
        "type": "boolean",
        "descs": {
          "zh-CN": "是否成功",
          "en-US": "Success"
        }
      },
      "bridge_path": "bluetooth.scanStop",
      "group": "scan",
      "description": "Stop ongoing Bluetooth device scanning"
    },
