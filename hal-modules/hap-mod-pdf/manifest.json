  "overviews": {
    "zh-CN": "提供 PDF 文件的创建、读取、编辑、合并、拆分、加密、水印等能力。支持文本提取、页面操作、表单填写、书签管理、图片插入等功能。",
    "en-US": "Create, read, edit, merge, split, encrypt, and watermark PDF files. Supports text extraction, page operations, form filling, bookmarks, and image insertion."
  }
}
