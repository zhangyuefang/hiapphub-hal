  "overviews": {
    "zh-CN": "提供 CSV 文件的读取、写入、追加、查询和转换能力。支持自定义分隔符、引号字符、编码格式，可将 CSV 转换为 JSON 或其他格式。",
    "en-US": "Read, write, append, query, and convert CSV files. Supports custom delimiters, quote characters, encodings, and CSV-to-JSON conversion."
  },
