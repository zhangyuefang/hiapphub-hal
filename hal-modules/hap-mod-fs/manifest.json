  "overviews": {
    "zh-CN": "提供文件系统操作能力，包括文件/目录的创建、读写、复制、移动、删除、权限管理、监控变化、临时文件管理等。支持文本和二进制文件操作、文件锁、符号链接等。",
    "en-US": "File system operations including create, read, write, copy, move, delete, permissions, change monitoring, and temp file management. Supports text/binary files, file locks, and symlinks."
  }
