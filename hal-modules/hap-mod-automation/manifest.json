      "descriptions": {
        "zh-CN": "连接到目标HAP应用，返回连接ID",
        "en-US": "Connect to target HAP app, returns connection ID"
      },
      "params": [
        { "name": "appId", "type": "string", "required": true, "descriptions": { "zh-CN": "目标应用ID", "en-US": "Target app ID" } },
        { "name": "window", "type": "string", "required": false, "descriptions": { "zh-CN": "窗口标签（默认main）", "en-US": "Window label (default main)" } }
      ],
      "returns": { "type": "object" },
      "async": true
    },
    {
      "name": "disconnect",
      "symbol": "hap_automation_disconnect",
      "descriptions": {
        "zh-CN": "断开与目标应用的连接",
