        { "name": "timeout", "type": "number", "required": false, "descriptions": { "zh-CN": "超时毫秒数（默认5000）", "en-US": "Timeout in ms (default 5000)" } }
      ],
      "returns": { "type": "object" },
      "async": true
    },
