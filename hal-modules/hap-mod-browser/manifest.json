  "icon": "🌐",
  "min_shell_version": "0.1.0",
  "category": "automation",
  "descriptions": {
    "zh-CN": "浏览器自动化模块（CDP协议）",
    "en-US": "Browser automation module (CDP protocol)"
  },
  "overviews": {
    "zh-CN": "通过Chrome DevTools Protocol控制外部浏览器，支持页面导航、元素操作、截图、Cookie管理、JavaScript执行、网络拦截等自动化能力。",
    "en-US": "Control external browsers via Chrome DevTools Protocol. Supports page navigation, element interaction, screenshots, cookie management, JavaScript execution, and network interception."
  },
  "permission": "browser",
  "functions": [
    {
      "name": "launch",
      "symbol": "hap_browser_launch",
      "descriptions": {
        "zh-CN": "启动浏览器实例",
        "en-US": "Launch browser instance"
      },
      "params": [
        {
          "name": "executable_path",
          "type": "string",
          "optional": true,
          "descs": {
            "zh-CN": "浏览器可执行文件路径（自动检测）",
            "en-US": "Browser executable path (auto-detect)"
          }
        },
        {
          "name": "headless",
          "type": "boolean",
          "optional": true,
          "default_value": "false",
          "descs": {
            "zh-CN": "是否无头模式",
            "en-US": "Headless mode"
          }
        },
        {
          "name": "user_data_dir",
          "type": "string",
          "optional": true,
          "descs": {
            "zh-CN": "用户数据目录",
            "en-US": "User data directory"
          }
        },
        {
          "name": "args",
          "type": "array",
          "optional": true,
          "descs": {
            "zh-CN": "额外启动参数",
            "en-US": "Extra launch arguments"
          }
        }
      ],
      "returns": {
        "type": "object",
        "descs": {
          "zh-CN": "浏览器实例信息",
          "en-US": "Browser instance info"
        }
      },
      "bridge_path": "browser.launch"
    },
    {
