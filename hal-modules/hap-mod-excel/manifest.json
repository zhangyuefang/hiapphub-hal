  "overviews": {
    "zh-CN": "提供 Excel（XLSX/XLS）文件的创建、读写、编辑能力。支持工作表管理、单元格操作、样式设置、公式、图表、数据验证、合并单元格、冻结窗格等功能。",
    "en-US": "Create, read, write, and edit Excel (XLSX/XLS) files. Supports worksheet management, cell operations, styling, formulas, charts, data validation, cell merging, and freeze panes."
  }
}
