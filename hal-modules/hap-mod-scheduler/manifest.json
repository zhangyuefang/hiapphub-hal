  "category": "utility",
  "descriptions": {
    "zh-CN": "定时任务模块",
    "en-US": "Task scheduler module",
    "zh-TW": "排程模組",
    "ja": "スケジューラモジュール",
    "ko": "스케줄러 모듈",
    "es": "Módulo de programador",
    "fr": "Module planificateur",
    "de": "Planer-Modul",
    "pt-BR": "Módulo de agendador",
    "ru": "Модуль планировщика",
    "ar": "وحدة الجدولة",
    "hi": "शेड्यूलर मॉड्यूल"
  },
  "overviews": {
    "zh-CN": "提供定时任务调度能力，支持Cron表达式、一次性延时任务、周期性任务、任务管理等功能。",
    "en-US": "Task scheduling with cron expressions, one-shot delayed tasks, periodic tasks, and task management."
  },
  "permission": "scheduler",
  "functions": [
    {
      "name": "create_cron",
      "symbol": "hap_scheduler_create_cron",
      "descriptions": {
        "zh-CN": "创建基于 Cron 表达式的定时任务（如每天凌晨3点执行）",
        "en-US": "Create scheduled task based on cron expression"
      },
      "params": [
        {
          "name": "name",
          "type": "string",
          "descs": {
            "zh-CN": "任务名称",
            "en-US": "Task name"
          }
        },
        {
          "name": "cron_expression",
          "type": "string",
          "descs": {
            "zh-CN": "Cron表达式",
            "en-US": "Cron expression"
          }
        },
        {
          "name": "callback_id",
          "type": "string",
          "descs": {
            "zh-CN": "触发时回调ID",
            "en-US": "Trigger callback ID"
          }
        }
      ],
      "returns": {
        "type": "TaskHandle",
        "descs": {
          "zh-CN": "任务信息",
          "en-US": "Task info"
        }
      },
      "bridge_path": "scheduler.createCron",
      "description": "Create scheduled task based on cron expression",
      "group": "create"
    },
    {
      "name": "create_interval",
      "symbol": "hap_scheduler_create_interval",
      "descriptions": {
        "zh-CN": "创建按固定时间间隔重复执行的定时任务",
        "en-US": "Create task that repeats at fixed interval"
      },
      "params": [
        {
          "name": "name",
          "type": "string",
          "descs": {
            "zh-CN": "任务名称",
            "en-US": "Task name"
          }
        },
        {
          "name": "interval_ms",
          "type": "number",
          "descs": {
            "zh-CN": "间隔(毫秒)",
            "en-US": "Interval (ms)"
          }
        },
        {
          "name": "callback_id",
          "type": "string",
          "descs": {
            "zh-CN": "回调ID",
            "en-US": "Callback ID"
          }
        },
        {
          "name": "repeat_count",
          "type": "number",
          "optional": true,
          "default_value": "0",
          "descs": {
            "zh-CN": "重复次数(0=无限)",
            "en-US": "Repeat count (0=infinite)"
          }
        }
      ],
      "returns": {
        "type": "TaskHandle",
        "descs": {
          "zh-CN": "任务信息",
          "en-US": "Task info"
        }
      },
      "bridge_path": "scheduler.createInterval",
      "description": "Create task that repeats at fixed interval",
      "group": "create"
    },
    {
      "name": "create_timeout",
      "symbol": "hap_scheduler_create_timeout",
      "descriptions": {
        "zh-CN": "创建在指定延迟后执行一次的延时任务",
        "en-US": "Create one-shot task that fires after specified delay"
      },
      "params": [
        {
          "name": "name",
          "type": "string",
          "descs": {
            "zh-CN": "任务名称",
            "en-US": "Task name"
          }
        },
        {
          "name": "delay_ms",
          "type": "number",
          "descs": {
            "zh-CN": "延迟(毫秒)",
            "en-US": "Delay (ms)"
          }
        },
        {
          "name": "callback_id",
          "type": "string",
          "descs": {
            "zh-CN": "回调ID",
            "en-US": "Callback ID"
          }
        }
      ],
      "returns": {
        "type": "TaskHandle",
        "descs": {
          "zh-CN": "任务信息",
          "en-US": "Task info"
        }
      },
      "bridge_path": "scheduler.createTimeout",
      "description": "Create one-shot task that fires after specified delay",
      "group": "create"
    },
    {
      "name": "cancel",
      "symbol": "hap_scheduler_cancel",
      "descriptions": {
        "zh-CN": "取消并删除一个已注册的定时任务",
        "en-US": "Cancel and remove a registered scheduled task"
      },
      "params": [
        {
          "name": "task_id",
          "type": "string",
          "descs": {
            "zh-CN": "任务ID",
            "en-US": "Task ID"
          }
        }
      ],
      "returns": {
        "type": "boolean",
        "descs": {
          "zh-CN": "是否成功",
          "en-US": "Success"
        }
      },
      "bridge_path": "scheduler.cancel",
      "description": "Cancel and remove a registered scheduled task",
      "group": "manage"
    },
    {
      "name": "pause",
      "symbol": "hap_scheduler_pause",
      "descriptions": {
        "zh-CN": "暂停一个定时任务（不删除，可恢复）",
        "en-US": "Pause a scheduled task (can be resumed later)"
      },
      "params": [
        {
          "name": "task_id",
          "type": "string",
          "descs": {
            "zh-CN": "任务ID",
            "en-US": "Task ID"
          }
        }
      ],
      "returns": {
        "type": "boolean",
        "descs": {
          "zh-CN": "是否成功",
          "en-US": "Success"
        }
      },
      "bridge_path": "scheduler.pause",
      "description": "Pause a scheduled task (can be resumed later)",
      "group": "manage"
    },
    {
      "name": "resume",
      "symbol": "hap_scheduler_resume",
      "descriptions": {
        "zh-CN": "恢复一个已暂停的定时任务继续执行",
        "en-US": "Resume a previously paused scheduled task"
      },
      "params": [
        {
          "name": "task_id",
          "type": "string",
          "descs": {
            "zh-CN": "任务ID",
            "en-US": "Task ID"
          }
        }
      ],
      "returns": {
        "type": "boolean",
        "descs": {
          "zh-CN": "是否成功",
          "en-US": "Success"
        }
      },
      "bridge_path": "scheduler.resume",
      "description": "Resume a previously paused scheduled task",
      "group": "manage"
    },
    {
      "name": "list",
      "symbol": "hap_scheduler_list",
      "descriptions": {
        "zh-CN": "获取所有已注册的定时任务列表及其状态",
        "en-US": "List all registered scheduled tasks with their status"
      },
      "params": [],
      "returns": {
        "type": "array",
        "descs": {
          "zh-CN": "任务列表",
          "en-US": "Task list"
        }
      },
      "bridge_path": "scheduler.list",
      "description": "List all registered scheduled tasks with their status",
      "group": "manage"
    },
    {
      "name": "get_next_run",
      "symbol": "hap_scheduler_get_next_run",
      "descriptions": {
        "zh-CN": "计算指定 Cron 任务的下一次执行时间",
        "en-US": "Calculate next execution time for a cron task"
      },
      "params": [
        {
          "name": "task_id",
          "type": "string",
          "descs": {
            "zh-CN": "任务ID",
            "en-US": "Task ID"
          }
        }
      ],
      "returns": {
        "type": "NextRun",
        "descs": {
          "zh-CN": "下次执行时间",
          "en-US": "Next run time"
        }
      },
      "bridge_path": "scheduler.getNextRun",
      "description": "Calculate next execution time for a cron task",
      "group": "manage"
    }
  ],
  "types": [
    {
      "name": "TaskHandle",
      "descriptions": {
        "zh-CN": "定时任务句柄",
        "en-US": "Schedule handle"
      },
      "fields": [
        {
          "name": "task_id",
          "type": "string",
          "descs": {
            "zh-CN": "任务ID",
            "en-US": "Task ID"
          }
        },
        {
          "name": "next_run",
          "type": "string",
          "optional": true,
          "descs": {
            "zh-CN": "下次执行时间",
            "en-US": "Next run time"
          }
        }
      ]
    },
    {
      "name": "NextRun",
      "descriptions": {
