        {
          "name": "data",
          "type": "string",
          "optional": true,
          "descs": {
            "zh-CN": "数据(hex)",
            "en-US": "Data (hex)"
          }
        },
        {
          "name": "timeout_ms",
          "type": "number",
          "optional": true,
          "default_value": "5000",
          "descs": {
            "zh-CN": "超时时间（毫秒）",
            "en-US": "Timeout in milliseconds"
          },
          "desc": "Timeout in milliseconds"
        }
      ],
      "returns": {
        "type": "TransferResult",
        "descs": {
          "zh-CN": "传输结果",
          "en-US": "Transfer result"
        }
      },
      "bridge_path": "usb.controlTransfer",
      "description": "Execute USB control transfer (read or write device control info)",
      "group": "transfer"
    },
