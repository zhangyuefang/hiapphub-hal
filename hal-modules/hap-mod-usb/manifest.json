  "overviews": {
    "zh-CN": "提供USB设备通信能力，支持设备枚举、HID读写、批量传输、设备信息查询等功能。",
    "en-US": "Provides USB device communication including device enumeration, HID read/write, bulk transfer, and device info queries."
  },
  "permission": "usb",
  "functions": [
    {
      "name": "list_devices",
      "symbol": "hap_usb_list_devices",
      "descriptions": {
        "zh-CN": "枚举系统中所有已连接的 USB 设备，可按厂商/产品ID过滤",
        "en-US": "Enumerate all connected USB devices with optional VID/PID filter"
      },
      "params": [
        {
          "name": "vendor_id",
          "type": "number",
          "optional": true,
          "descs": {
            "zh-CN": "厂商ID过滤",
            "en-US": "Vendor ID filter"
          }
        },
        {
          "name": "product_id",
          "type": "number",
          "optional": true,
          "descs": {
            "zh-CN": "产品ID过滤",
            "en-US": "Product ID filter"
          }
        }
      ],
      "returns": {
        "type": "array",
        "descs": {
          "zh-CN": "设备列表",
          "en-US": "Device list"
        }
      },
      "bridge_path": "usb.listDevices",
      "description": "Enumerate all connected USB devices with optional VID/PID filter",
      "group": "device"
    },
    {
      "name": "open",
      "symbol": "hap_usb_open",
      "descriptions": {
        "zh-CN": "打开指定的 USB 设备并声明接口，获取操作句柄",
        "en-US": "Open USB device, claim interface and get operation handle"
      },
      "params": [
        {
          "name": "vendor_id",
          "type": "number",
          "descs": {
            "zh-CN": "厂商ID",
            "en-US": "Vendor ID"
          }
        },
        {
          "name": "product_id",
          "type": "number",
          "descs": {
            "zh-CN": "产品ID",
            "en-US": "Product ID"
          }
        },
        {
          "name": "interface_number",
          "type": "number",
          "optional": true,
          "default_value": "0",
          "descs": {
            "zh-CN": "interface_number参数",
            "en-US": "interface_number parameter"
          },
          "desc": "interface_number parameter"
        }
      ],
      "returns": {
        "type": "UsbHandle",
        "descs": {
          "zh-CN": "设备句柄信息",
          "en-US": "Device handle info"
        }
      },
      "bridge_path": "usb.open",
      "description": "Open USB device, claim interface and get operation handle",
      "group": "device"
    },
    {
      "name": "close",
      "symbol": "hap_usb_close",
      "descriptions": {
        "zh-CN": "释放 USB 设备接口并关闭连接句柄",
        "en-US": "Release USB interface and close device handle"
      },
      "params": [
        {
          "name": "handle_id",
          "type": "string",
          "descs": {
            "zh-CN": "设备句柄ID",
            "en-US": "Device handle ID"
          }
        }
      ],
      "returns": {
        "type": "boolean",
        "descs": {
          "zh-CN": "是否成功",
          "en-US": "Success"
        }
      },
      "bridge_path": "usb.close",
      "description": "Release USB interface and close device handle",
      "group": "device"
    },
    {
      "name": "bulk_transfer_out",
      "symbol": "hap_usb_bulk_transfer_out",
      "descriptions": {
        "zh-CN": "向 USB 设备的批量传输端点写入数据",
        "en-US": "Write data to USB device bulk transfer endpoint"
      },
      "params": [
        {
          "name": "handle_id",
          "type": "string",
          "descs": {
            "zh-CN": "设备句柄ID",
            "en-US": "Handle ID"
          }
        },
        {
          "name": "endpoint",
          "type": "number",
          "descs": {
            "zh-CN": "endpoint参数",
            "en-US": "endpoint parameter"
          },
          "desc": "endpoint parameter"
        },
        {
          "name": "data",
          "type": "string",
          "descs": {
            "zh-CN": "数据(hex编码)",
            "en-US": "Data (hex encoded)"
          }
        },
        {
          "name": "timeout_ms",
          "type": "number",
          "optional": true,
          "default_value": "5000",
          "descs": {
            "zh-CN": "超时(毫秒)",
            "en-US": "Timeout (ms)"
          }
        }
      ],
      "returns": {
        "type": "TransferResult",
        "descs": {
          "zh-CN": "传输结果",
          "en-US": "Transfer result"
        }
      },
      "bridge_path": "usb.bulkTransferOut",
      "description": "Write data to USB device bulk transfer endpoint",
      "group": "transfer"
