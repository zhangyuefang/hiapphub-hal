      "params": [
        {
          "name": "handle_id",
          "type": "string",
          "descs": {
            "zh-CN": "设备句柄ID",
            "en-US": "Handle ID"
          }
        },
        {
          "name": "endpoint",
          "type": "number",
          "descs": {
            "zh-CN": "endpoint参数",
            "en-US": "endpoint parameter"
          },
          "desc": "endpoint parameter"
        },
        {
          "name": "length",
          "type": "number",
          "descs": {
            "zh-CN": "读取长度",
            "en-US": "Read length"
