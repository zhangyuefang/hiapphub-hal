  "descriptions": {
    "zh-CN": "USB设备通信模块",
    "en-US": "USB device communication module",
    "zh-TW": "USB 模組",
    "ja": "USBモジュール",
    "ko": "USB 모듈",
    "es": "Módulo USB",
