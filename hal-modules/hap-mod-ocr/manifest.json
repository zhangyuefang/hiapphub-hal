  "descriptions": {
    "zh-CN": "文字识别(OCR)模块",
    "en-US": "Optical Character Recognition module"
  },
  "overviews": {
    "zh-CN": "提供本地OCR文字识别能力，支持图片文字提取、区域识别、多语言识别、表格识别等功能。调用系统原生OCR引擎（macOS Vision/Windows OCR/Linux Tesseract）。",
    "en-US": "Local OCR text recognition using native engines (macOS Vision/Windows OCR/Linux Tesseract). Supports image text extraction, region recognition, multi-language, and table recognition."
  },
  "permission": "ocr",
  "functions": [
    {
      "name": "recognize",
      "symbol": "hap_ocr_recognize",
      "descriptions": {
        "zh-CN": "识别图片中的文字",
        "en-US": "Recognize text in image"
      },
      "params": [
        {
          "name": "image_path",
          "type": "string",
          "descs": {
            "zh-CN": "图片路径",
            "en-US": "Image path"
          }
        },
        {
          "name": "languages",
          "type": "array",
          "optional": true,
          "descs": {
            "zh-CN": "语言列表(如[\"zh-CN\",\"en\"])",
            "en-US": "Languages (e.g. [\"zh-CN\",\"en\"])"
          }
        }
      ],
      "returns": {
        "type": "object",
        "descs": {
          "zh-CN": "识别结果",
          "en-US": "Recognition result"
        }
      },
      "bridge_path": "ocr.recognize"
    },
