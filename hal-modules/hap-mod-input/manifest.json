          "name": "text",
          "type": "string",
          "descs": {
            "zh-CN": "文本内容",
            "en-US": "Text content"
          }
        },
        {
          "name": "delay_ms",
          "type": "number",
          "optional": true,
          "default_value": "0",
          "descs": {
            "zh-CN": "字符间延迟(毫秒)",
            "en-US": "Delay between chars (ms)"
          }
        }
      ],
      "returns": {
        "type": "boolean",
        "descs": {
          "zh-CN": "是否成功",
          "en-US": "Success"
        }
      },
      "bridge_path": "input.typeText",
      "group": "keyboard",
      "description": "Simulate typing text character by character with optional delay"
