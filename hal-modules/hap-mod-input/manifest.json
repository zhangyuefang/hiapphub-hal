  "category": "automation",
  "descriptions": {
    "zh-CN": "模拟输入模块",
    "en-US": "Input simulation module"
  },
  "overviews": {
    "zh-CN": "提供键盘和鼠标模拟输入能力，支持按键模拟、文本输入、鼠标移动/点击/拖拽、组合键、滚轮操作等自动化功能。",
    "en-US": "Keyboard and mouse input simulation including key press, text input, mouse move/click/drag, key combinations, and scroll operations."
  },
  "permission": "input",
  "functions": [
    {
      "name": "key_press",
      "symbol": "hap_input_key_press",
      "descriptions": {
        "zh-CN": "模拟按下并释放一个键盘按键，支持组合修饰键",
        "en-US": "Simulate key press and release with optional modifier keys"
      },
      "params": [
        {
          "name": "key",
          "type": "string",
          "descs": {
            "zh-CN": "键名(如enter/tab/escape/a/1)",
            "en-US": "Key name (e.g. enter/tab/escape/a/1)"
          }
        },
        {
          "name": "modifiers",
          "type": "array",
          "optional": true,
          "descs": {
            "zh-CN": "修饰键列表[ctrl/alt/shift/meta]",
            "en-US": "Modifiers [ctrl/alt/shift/meta]"
          }
        }
      ],
      "returns": {
        "type": "boolean",
        "descs": {
          "zh-CN": "是否成功",
          "en-US": "Success"
        }
      },
      "bridge_path": "input.keyPress",
      "group": "keyboard",
      "description": "Simulate key press and release with optional modifier keys"
    },
    {
      "name": "key_down",
      "symbol": "hap_input_key_down",
      "descriptions": {
        "zh-CN": "模拟按住一个键盘按键（不释放）",
        "en-US": "Simulate holding down a key (without releasing)"
      },
      "params": [
        {
          "name": "key",
          "type": "string",
          "descs": {
            "zh-CN": "要按下的键名（如Enter/Tab/A）",
            "en-US": "Key name to press down (e.g. Enter/Tab/A)"
          },
          "desc": "Key name to press down (e.g. Enter/Tab/A)"
        }
      ],
      "returns": {
        "type": "boolean",
        "descs": {
          "zh-CN": "是否成功",
          "en-US": "Success"
        }
      },
      "bridge_path": "input.keyDown",
      "group": "keyboard",
      "description": "Simulate holding down a key (without releasing)"
    },
    {
      "name": "key_up",
      "symbol": "hap_input_key_up",
      "descriptions": {
        "zh-CN": "释放之前按住的键盘按键",
        "en-US": "Release a previously held key"
      },
      "params": [
        {
          "name": "key",
          "type": "string",
          "descs": {
            "zh-CN": "要释放的键名（如Enter/Tab/A）",
            "en-US": "Key name to release (e.g. Enter/Tab/A)"
          },
          "desc": "Key name to release (e.g. Enter/Tab/A)"
        }
      ],
      "returns": {
        "type": "boolean",
        "descs": {
          "zh-CN": "是否成功",
          "en-US": "Success"
        }
      },
      "bridge_path": "input.keyUp",
      "group": "keyboard",
      "description": "Release a previously held key"
    },
    {
